{
  "name": "clearerr",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "description": "Structured errors for AI agents. Lint-enforced envelopes, one-line JSON on stderr.",
  "author": "Arash Jafari",
  "license": "MIT",
  "homepage": "https://github.com/arxja/clearerr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arxja/clearerr.git"
  },
  "bugs": "https://github.com/arxja/clearerr/issues",
  "keywords": [
    "agent",
    "error",
    "structured",
    "lint",
    "json",
    "envelope",
    "ai"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./linter": {
      "types": "./dist/linter/index.d.mts",
      "import": "./dist/linter/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "clearerr": "./bin/clearerr.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "precision": "tsx scripts/precision.ts",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:pkg": "pnpm run build && vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test:pkg"
  },
  "dependencies": {
    "citty": "catalog:prod",
    "picocolors": "catalog:prod",
    "ts-morph": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@types/bun": "catalog:core",
    "@types/node": "catalog:core",
    "@vitest/coverage-v8": "catalog:test",
    "bumpp": "catalog:git",
    "eslint": "catalog:lint",
    "eslint-plugin-slop": "catalog:lint",
    "eslint-plugin-sonarjs": "catalog:lint",
    "knip": "catalog:lint",
    "nano-staged": "catalog:git",
    "publint": "catalog:lint",
    "simple-git-hooks": "catalog:git",
    "tsdown": "catalog:build",
    "tsdown-stale-guard": "catalog:test",
    "tsnapi": "catalog:api",
    "tsx": "catalog:build",
    "typescript": "catalog:core",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  }
}
